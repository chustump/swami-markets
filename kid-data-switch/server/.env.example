# Copy to .env and fill in. Never commit .env.

# Access code the phone app must send. Make it long and random.
KDS_TOKEN=change-me-to-a-long-random-string
KDS_PORT=8787

# The kid's line as it is labelled in the US Mobile dashboard.
KID_LINE_NAME=Kid Phone

# The kid's phone as it is named in the Cox Panoramic Wifi device list.
KID_DEVICE_NAME=Kid iPhone

# Optional: lets the server sign back in by itself when a session expires.
# Leave blank to always sign in by hand with "npm run login <provider>".
USMOBILE_EMAIL=
USMOBILE_PASSWORD=
COX_USERNAME=
COX_PASSWORD=
