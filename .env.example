# ─────────────────────────────────────────────────────────────
# Swami Markets — environment variables
# Copy to .env.local (Next.js) and/or export in the worker's env.
# ─────────────────────────────────────────────────────────────

# Anthropic (existing market-analysis routes)
ANTHROPIC_API_KEY=

# ── NATS / JetStream ─────────────────────────────────────────
# Comma-separated list of NATS servers.
NATS_URL=nats://localhost:4222
# Auth — set the ones your broker uses (token OR user/pass OR creds file).
NATS_TOKEN=
NATS_USER=
NATS_PASS=
# Path to a NATS .creds file (Synadia Cloud / NGS).
NATS_CREDS=
NATS_CLIENT_NAME=swami-markets

# JetStream stream + subject namespace.
NATS_STREAM=SWAMI_ORCHESTRATION
NATS_SUBJECT_PREFIX=swami.orchestration
NATS_STREAM_MAX_AGE_MS=604800000          # 7 days

# Bridge worker consumer settings.
NATS_CONSUMER=hermes-bridge
BRIDGE_CONCURRENCY=4
BRIDGE_PUBLISH_RESULTS=true

# ── Hermes.ai agentic orchestration ─────────────────────────
HERMES_API_URL=https://api.hermes.ai/v1
HERMES_API_KEY=
HERMES_AGENT_ID=swami-market-analyst
HERMES_WORKSPACE_ID=
HERMES_TIMEOUT_MS=60000
