# --- Existing app ---------------------------------------------------------
# Used by /api/ask and /api/analyze (The Swami oracle).
ANTHROPIC_API_KEY=

# --- Grok MCP server ------------------------------------------------------
# xAI API key. Create one at https://console.x.ai
XAI_API_KEY=

# Optional. Default Grok model for both tools. The lineup changes often - run
#   curl -H "Authorization: Bearer $XAI_API_KEY" https://api.x.ai/v1/models
# to see what your key can actually use.
XAI_MODEL=grok-4.6

# Optional. Override the xAI API base URL.
# XAI_BASE_URL=https://api.x.ai/v1

# Required ONLY for the remote connector at /api/mcp.
# Any long random string; generate one with:  openssl rand -hex 32
# Without it the endpoint refuses all traffic rather than becoming an open,
# billable proxy to your xAI account.
MCP_AUTH_TOKEN=
